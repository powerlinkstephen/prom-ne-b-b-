{"sidebar-1":{"block-1":{"content":"<!-- wp:search {\"showLabel\":false,\"placeholder\":\"Search here...\",\"buttonUseIcon\":true} \/-->"},"custom_recent_posts_widget-2":{"title":"Recent Posts","title_word_limit":15,"post_count":3,"order_by":"date","order":"desc","category_filter":null},"block-2":{"content":"<!-- wp:widget-group {\"title\":\"Categories\"} -->\n<h2 class=\"widget-title\">Categories<\/h2><div class=\"wp-widget-group__inner-blocks\"><!-- wp:group -->\n<div class=\"wp-block-group\"><!-- wp:categories {\"showPostCounts\":true} \/--><\/div>\n<!-- \/wp:group --><\/div>\n<!-- \/wp:widget-group -->"},"block-3":{"content":"<!-- wp:widget-group {\"title\":\"Tags\"} -->\n<h2 class=\"widget-title\">Tags<\/h2><div class=\"wp-widget-group__inner-blocks\"><!-- wp:group -->\n<div class=\"wp-block-group\"><!-- wp:tag-cloud \/--><\/div>\n<!-- \/wp:group --><\/div>\n<!-- \/wp:widget-group -->"},"block-4":{"content":"<!-- wp:widget-group {\"title\":\"Comments\"} -->\n<h2 class=\"widget-title\">Comments<\/h2><div class=\"wp-widget-group__inner-blocks\"><!-- wp:latest-comments {\"commentsToShow\":4,\"displayAvatar\":false,\"displayDate\":false,\"displayExcerpt\":false} \/--><\/div>\n<!-- \/wp:widget-group -->"}},"shop":{"block-5":{"content":"<!-- wp:search {\"label\":\"Search\",\"showLabel\":false,\"placeholder\":\"Search product\",\"buttonText\":\"Search\",\"buttonUseIcon\":true} \/-->"},"block-6":{"content":"<!-- wp:woocommerce\/filter-wrapper {\"filterType\":\"price-filter\",\"heading\":\"Filter by price\"} -->\n<div class=\"wp-block-woocommerce-filter-wrapper\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Price<\/h3>\n<!-- \/wp:heading -->\n\n<!-- wp:woocommerce\/price-filter {\"showInputFields\":false,\"showFilterButton\":true,\"heading\":\"\",\"lock\":{\"remove\":true}} -->\n<div class=\"wp-block-woocommerce-price-filter is-loading\" data-showinputfields=\"false\" data-showfilterbutton=\"true\" data-heading=\"\" data-heading-level=\"3\"><span aria-hidden=\"true\" class=\"wc-block-product-categories__placeholder\"><\/span><\/div>\n<!-- \/wp:woocommerce\/price-filter --><\/div>\n<!-- \/wp:woocommerce\/filter-wrapper -->"},"block-7":{"content":"<!-- wp:widget-group {\"title\":\"Categories\"} -->\n<h2 class=\"widget-title\">Categories<\/h2><div class=\"wp-widget-group__inner-blocks\"><!-- wp:categories \/--><\/div>\n<!-- \/wp:widget-group -->"}}}